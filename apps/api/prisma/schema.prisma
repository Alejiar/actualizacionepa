// Cash Buddy EPA - Esquema de base de datos
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS - Sistema original
// ============================================================

enum UserRole {
  admin
  user
}

enum WorkerRole {
  domiciliario
  administrativo
}

enum MovementType {
  ingreso
  egreso
}

enum Medium {
  cash
  bank
}

enum MovementStatus {
  pending
  confirmed
}

enum MovementKind {
  commission
  delivery
}

// ============================================================
// ENUMS - Sistema Shipday
// ============================================================

enum BaseType {
  entrega
  pago
}

enum ConversionType {
  banco_a_efectivo
  efectivo_a_banco
}

enum SyncStatus {
  ok
  error
  never
}

enum BankTxType {
  ingreso
  egreso
}

enum EditRequestStatus {
  pending
  approved
  rejected
}

enum ShiftSlot {
  AM
  PM
  close
}

// ============================================================
// MODELOS - Sistema original (sin cambios)
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(user)
  active       Boolean  @default(true)
  // Versión de sesión: los tokens llevan `tv`; cambiar contraseña/rol/estado la incrementa.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  editRequests  EditRequest[] @relation("requester")
  reviewedEdits EditRequest[] @relation("reviewer")
}

model EditRequest {
  id          String            @id @default(cuid())
  requesterId String
  requestType String            @default("edit") // "edit" | "delete"
  entityType  String // "ShipdayOrder" | "Movement" | "BankTransaction" | etc.
  entityId    String // ID del registro a editar/eliminar
  entityLabel String // Descripción legible: "Pedido #30 - $90.000"
  changes     Json // { field: { old, new }, ... } — vacío si es delete
  reason      String
  status      EditRequestStatus @default(pending)
  reviewerId  String?
  reviewNotes String?
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())

  requester User  @relation("requester", fields: [requesterId], references: [id])
  reviewer  User? @relation("reviewer", fields: [reviewerId], references: [id])

  @@index([status])
  @@index([requesterId])
}

model Settings {
  id                String    @id @default("singleton")
  companyName       String    @default("Epa")
  brandName         String    @default("Cash Buddy")
  logoData          String?   @db.Text // Logo en base64 (data URL), se adapta solo
  termsAcceptedAt   DateTime? // Fecha de aceptación de T&C (inicia garantía de 2 meses)
  initialCash       Int       @default(300000)
  initialBank       Int       @default(103130)
  setupComplete     Boolean   @default(false)
  commissionPercent Float     @default(0)
  // Porcentaje que cobra la empresa por cada domicilio Shipday
  shipdayCommission Float     @default(30)
  updatedAt         DateTime  @updatedAt
}

model FieldNote {
  id        String   @id @default(cuid())
  date      String   @default("") // YYYY-MM-DD — día al que pertenece la nota
  content   String   @db.Text
  author    String? // nombre de quien escribió
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([createdAt])
}

model Worker {
  id        String     @id @default(cuid())
  name      String
  role      WorkerRole @default(domiciliario)
  active    Boolean    @default(true)
  color     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  movements Movement[]
}

model Day {
  date        String   @id
  initialCash Int
  initialBank Int
  arqueoAM    Json?
  arqueoPM    Json?
  arqueoClose Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements Movement[]
}

model Movement {
  id             String         @id @default(cuid())
  date           String
  time           String
  category       Int
  type           MovementType
  medium         Medium
  amount         Int
  status         MovementStatus @default(confirmed)
  description    String?
  group          String?
  kind           MovementKind?
  deliveryId     String?
  deliveryValue  Int?
  taxAmount      Int?
  createdBy      String?
  createdByName  String?
  deviceId       String? // PC (Device.id) que registró el movimiento
  deviceName     String? // nombre del PC en ese momento (snapshot, para mostrar inline)
  approvedBy     String?
  approvedByName String?
  approvedAt     DateTime?
  createdAt      DateTime       @default(now())

  day      Day     @relation(fields: [date], references: [date], onDelete: Cascade)
  worker   Worker? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  workerId String?

  @@index([date])
  @@index([date, status])
  @@index([workerId])
  @@index([kind])
  @@index([status])
}

// ============================================================
// MODELOS - Sistema Shipday multi-sucursal
// ============================================================

model Branch {
  id          String     @id @default(cuid())
  name        String
  address     String?
  phone       String?
  apiKeyEnc   String // API Key cifrada en AES-256
  active      Boolean    @default(true)
  syncStatus  SyncStatus @default(never)
  syncMessage String?
  lastSyncAt  DateTime?
  ordersSince DateTime? // Solo se cargan pedidos entregados DESDE esta fecha (día de arranque)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  drivers     Driver[]
  orders      ShipdayOrder[]
  bases       BaseTransaction[]
  conversions Conversion[]
  closes      MonthlyClose[]
  dailyStats  DailyDriverStat[]
}

model Driver {
  id              String   @id @default(cuid())
  shipdayDriverId String
  branchId        String
  name            String
  phone           String?
  email           String?
  active          Boolean  @default(true)
  pendingDebt     Int      @default(0)
  creditAmount    Int      @default(0)
  creditMedium    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch     Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders     ShipdayOrder[]
  bases      BaseTransaction[]
  payments   DriverPayment[]
  dailyStats DailyDriverStat[]

  @@unique([shipdayDriverId, branchId])
  @@index([branchId])
  @@index([pendingDebt])
}

model ShipdayOrder {
  manualOverride       Boolean     @default(false)
  manualOriginalValue  Int?
  manualOverrideBy     String?
  manualOverrideAt     DateTime?
  shipdayDeliveryValue Int?
  clientDebt           ClientDebt?
  id                   String      @id @default(cuid())
  shipdayOrderId       String      @unique
  branchId             String
  driverId             String?
  orderNumber          String?
  deliveryValue        Int         @default(0)
  companyAmount        Int         @default(0)
  customerName         String?
  customerAddress      String?
  status               String
  deliveredAt          DateTime?
  rawData              Json?
  clientId             String?
  addToClientDebt      Boolean     @default(false)
  createdAt            DateTime    @default(now())

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  driver Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([branchId, status])
  @@index([driverId])
  @@index([deliveredAt])
  @@index([status])
}

// Lápida (tombstone) de un pedido de Shipday eliminado por aprobación de EditRequest.
// Shipday SIGUE reportando ese pedido como entregado (ALREADY_DELIVERED), así que el
// polling (persistDeliveredOrder) o el webhook lo RE-CREARÍAN, resucitando la deuda y la
// estadística que la eliminación acababa de revertir. Guardar aquí su shipdayOrderId hace
// que ambos paths se nieguen a recrearlo. Sin esto, aprobar la eliminación de un pedido
// "no pega": el siguiente sync lo trae de vuelta y en el historial la solicitud queda como
// Aprobada aunque el pedido siga vivo (bug real, Pedido #35, 18-ago-2026).
model DeletedShipdayOrder {
  shipdayOrderId String    @id
  branchId       String?
  orderNumber    String?
  deliveredAt    DateTime?
  deletedBy      String?
  deletedAt      DateTime  @default(now())
}

model BaseTransaction {
  id                String   @id @default(cuid())
  branchId          String
  driverId          String
  amount            Int
  cashAmount        Int      @default(0)
  bankAmount        Int      @default(0)
  type              BaseType
  notes             String?
  createdBy         String?
  createdByName     String?
  deviceId          String? // PC (Device.id) que registró la base
  deviceName        String? // nombre del PC en ese momento (snapshot)
  date              DateTime @default(now())
  // Vínculo directo al BankTransaction que originó este registro (pago vía banco
  // aplicado a la deuda). Antes se buscaba por fecha aproximada (±5s), lo que
  // fallaba si el BankTransaction quedaba con una fecha distinta a "ahora" (p. ej.
  // fecha seleccionada manualmente) y dejaba registros huérfanos al eliminar el
  // BankTransaction. Con el ID no hay ambigüedad posible.
  bankTransactionId String?

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  driver          Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  // Cascade, NO SetNull: con SetNull, borrar el BankTransaction dejaba este registro
  // vivo y con bankTransactionId=null — un "pago" fantasma imposible de rastrear que
  // mantenía la deuda del domiciliario en cero. Con Cascade, si alguna ruta de borrado
  // olvida la limpieza explícita, el registro se va igual y el descuadre es visible.
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([driverId])
  @@index([driverId, type])
  @@index([date])
  @@index([bankTransactionId])
}

model DriverPayment {
  id                String   @id @default(cuid())
  driverId          String
  branchId          String
  amount            Int
  medium            Medium   @default(cash)
  notes             String?
  createdBy         String?
  createdByName     String?
  deviceId          String? // PC (Device.id) que registró el pago
  deviceName        String? // nombre del PC en ese momento (snapshot)
  date              DateTime @default(now())
  // Ver comentario en BaseTransaction.bankTransactionId.
  bankTransactionId String?

  driver          Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  // Cascade, NO SetNull: ver comentario en BaseTransaction.bankTransaction.
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([branchId])
  @@index([bankTransactionId])
}

model Conversion {
  id         String         @id @default(cuid())
  branchId   String
  amount     Int
  type       ConversionType
  notes      String?
  userId     String?
  userName   String?
  deviceId   String? // PC (Device.id) que registró la conversión
  deviceName String? // nombre del PC en ese momento (snapshot)
  driverId   String? // domiciliario asociado (opcional)
  driverName String? // nombre cacheado para historial
  date       DateTime       @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([date])
  @@index([driverId])
}

model DailyDriverStat {
  id           String @id @default(cuid())
  date         String // YYYY-MM-DD
  branchId     String
  driverId     String
  orderCount   Int    @default(0)
  totalValue   Int    @default(0)
  companyTotal Int    @default(0)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([date, driverId])
  @@index([branchId])
  @@index([date])
  @@index([date, branchId])
}

model MonthlyClose {
  id                String   @id @default(cuid())
  branchId          String?
  month             String // YYYY-MM
  totalOrders       Int
  totalValue        Int
  companyTotal      Int
  basesGiven        Int
  basesPaid         Int
  basesPending      Int
  conversions       Json
  snapshot          Json
  initialCash       Int?
  initialBank       Int?
  // Indicadores del reporte mensual (estilo Excel)
  totalSales        Int?
  totalExpenses     Int?
  totalPayroll      Int?
  transferDiff      Int?
  clientDebtBalance Int?
  netProfit         Int?
  profitability     Float?
  closedBy          String?
  closedByName      String?
  closedAt          DateTime @default(now())
  locked            Boolean  @default(true) // bloqueado al cerrarse; modificarlo requiere EditRequest

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([month, branchId])
  @@index([month])
}

// ============================================================
// NUEVOS MODELOS
// ============================================================

model Client {
  payments    ClientDebtPayment[]
  id          String              @id @default(cuid())
  name        String
  phone       String?
  email       String?
  address     String?
  notes       String?
  pendingDebt Int                 @default(0)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  debts  ClientDebt[]
  orders ShipdayOrder[]
}

model ClientDebt {
  sourceOrderId  String?             @unique
  sourceOrder    ShipdayOrder?       @relation(fields: [sourceOrderId], references: [id], onDelete: Restrict)
  payments       ClientDebtPayment[]
  id             String              @id @default(cuid())
  clientId       String
  description    String
  amount         Int
  // Medio del que SALIÓ el dinero al crear la deuda (préstamo/adelanto al cliente).
  // Cuando está definido, el saldo esperado descuenta `amount` de ese medio al
  // crearse la deuda y lo vuelve a sumar (paidCash/paidBank) al cobrarse — neto cero
  // al saldarse. Nulo = deuda sin desembolso de caja (p. ej. domicilio a crédito):
  // no descuenta al crear, solo suma como ingreso al cobrarse.
  medium         Medium?
  paid           Boolean             @default(false)
  paidAt         DateTime?
  paidAmount     Int?
  paidCash       Int                 @default(0)
  paidBank       Int                 @default(0)
  createdBy      String?
  createdByName  String?
  deviceId       String? // PC (Device.id) que creó la deuda
  deviceName     String? // nombre del PC al crearla (snapshot)
  paidBy         String?
  paidByName     String?
  paidDeviceId   String? // PC que registró el cobro
  paidDeviceName String? // nombre del PC al cobrar (snapshot)
  createdAt      DateTime            @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, paid])
  @@index([paid])
}

model BankTransaction {
  id            String     @id @default(cuid())
  type          BankTxType
  medium        Medium     @default(bank) // efectivo o transferencia(banco)
  amount        Int
  description   String
  reference     String?
  driverId      String? // domiciliario asociado (opcional, solo trazabilidad)
  driverName    String? // nombre cacheado para historial
  groupId       String? // enlaza las dos mitades de un movimiento mixto (efectivo+transferencia)
  pairId        String? // enlaza un movimiento con su contraparte (salida ↔ retorno) de forma explícita
  noCounterpart Boolean    @default(false) // marcado explícito: este movimiento NO requiere contraparte
  // Cuánto redujo este movimiento la POSICIÓN NETA (deuda − crédito) del domiciliario.
  // 0 = nunca se aplicó a una deuda. Es el ÚNICO marcador válido para revertir al
  // eliminar: antes se deducía de (driverId && noCounterpart && type=="ingreso"), y esa
  // heurística falló con un egreso aplicado por error a una deuda — se borró el
  // movimiento y la deuda del domiciliario nunca se restableció (caso Luisa Palencia,
  // 17-jul-2026). Con este campo la reversión no depende de adivinar el tipo.
  debtApplied   Int        @default(0)
  // Enlace suelto (sin FK) al turno por hora que originó este movimiento (pago al
  // domiciliario = egreso, cobro al cliente = ingreso). Permite borrar TODA la huella
  // bancaria de un turno de una sola vez al eliminarlo, sin dejar cobros colgados ni
  // egresos de compensación. Nulo en todo movimiento que no venga de "Clientes por hora".
  hourlyShiftId String?
  createdBy     String?
  createdByName String?
  deviceId      String? // PC (Device.id) que registró el movimiento
  deviceName    String? // nombre del PC en ese momento (snapshot)
  date          DateTime   @default(now())
  createdAt     DateTime   @default(now())

  baseTransactions BaseTransaction[]
  driverPayments   DriverPayment[]

  @@index([date])
  @@index([type])
  @@index([driverId])
  @@index([groupId])
  @@index([pairId])
  @@index([hourlyShiftId])
}

model ShiftClose {
  id             String    @id @default(cuid())
  date           String // YYYY-MM-DD
  shift          ShiftSlot
  receivedBy     String?
  handedBy       String?
  denominations  Json
  totalCounted   Int
  totalExpected  Int
  difference     Int
  // Conciliación del BANCO (además del efectivo). El operador ingresa el saldo real
  // del banco y se compara contra el esperado del sistema, para detectar descuadres
  // bancarios que el conteo de efectivo no puede ver. Nulos en turnos antiguos.
  bankCounted    Int?
  bankExpected   Int?
  bankDifference Int?
  notes          String?
  createdBy      String?
  createdByName  String?
  // Edición autorizada de cierres
  editedBy       String?
  editedByName   String?
  editedAt       DateTime?
  closedAt       DateTime  @default(now())
  locked         Boolean   @default(true) // bloqueado al registrarse; modificarlo requiere EditRequest
  /// D7 (14-oct-2026): correcciones aprobadas DESPUÉS del cierre sobre dinero de este día
  /// (mes abierto). Cada una: { requestId, requestType, entityType, entityId, description,
  /// cashDelta, bankDelta, approvedBy, approvedByName, approvedAt }. El conteo original
  /// (totalCounted/totalExpected/difference) nunca se modifica.
  corrections    Json      @default("[]")

  @@unique([date, shift])
  @@index([date])
}

// ============================================================
// MODELOS - Clientes por hora (alquiler de domiciliarios)
// ============================================================

// Empresa/tienda a la que se le alquilan domiciliarios por hora. Maneja DOS tarifas por
// hora: lo que gana el domiciliario y la ganancia de la empresa; el total a cobrarle al
// cliente es la suma de ambas. `pendingDebt` es un ledger informativo aparte —igual que
// Client.pendingDebt—: los movimientos REALES de dinero (pago al domiciliario = egreso,
// cobro al cliente = ingreso) se registran como BankTransaction, y SON ESOS los que
// afectan el saldo esperado de caja/banco. NO sumar `pendingDebt` al esperado, o el mismo
// dinero se contaría dos veces.
model HourlyClient {
  id               String   @id @default(cuid())
  name             String
  driverHourValue  Int // valor de la hora para el domiciliario (p. ej. 15.000)
  companyHourValue Int // ganancia de la empresa por hora (p. ej. 5.000)
  pendingDebt      Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shifts HourlyShift[]
}

// Un turno trabajado por un domiciliario para un HourlyClient. Las tarifas se CONGELAN al
// registrar (driverAmount/companyAmount/totalAmount ya calculados por minutos), así que
// cambiar la tarifa del cliente después NO altera turnos viejos.
//
// Dos etapas de dinero, cada una idempotente por su propia bandera:
//  1) driverPaid — se le pagó al domiciliario (BankTransaction egreso en driverPaidBankTxId).
//     Recién AHÍ el `totalAmount` del turno entra a la deuda del cliente. Sin pagar = sin
//     deuda (regla del dueño: la deuda del cliente se genera al pagar al domiciliario).
//  2) paid/paidAmount — el cliente abonó/pagó su deuda (mismo patrón que ClientDebt, FIFO).
//
// driverId/driverName se guardan como campos sueltos (SIN relación con Driver, igual que
// Conversion): el sistema por hora es independiente de la deuda de domicilios del driver;
// pagarle la hora NO toca su pendingDebt/creditAmount.
model HourlyShift {
  id                 String    @id @default(cuid())
  hourlyClientId     String
  driverId           String?
  driverName         String
  date               String // YYYY-MM-DD (día del turno, zona Bogotá)
  startTime          String // "HH:MM"
  endTime            String // "HH:MM"
  minutes            Int
  driverAmount       Int
  companyAmount      Int
  totalAmount        Int
  // Tarifa con la que se calculó el turno (decisión del dueño, 15-oct-2026): cambiar la tarifa
  // del cliente NO recalcula turnos ya registrados. Null solo en turnos viejos cuyo cálculo no
  // pudo reconstruirse con la tarifa vigente al migrar.
  driverHourValue    Int?
  companyHourValue   Int?
  // Etapa 1 — pago al domiciliario
  driverPaid         Boolean   @default(false)
  driverPaidMedium   Medium?
  driverPaidAt       DateTime?
  driverPaidBankTxId String? // BankTransaction (egreso) del pago; enlace suelto, sin FK
  driverPaidBy       String? // quién registró el pago al domiciliario
  driverPaidByName   String?
  // Etapa 2 — cobro al cliente
  paid               Boolean   @default(false)
  paidAmount         Int       @default(0)
  paidAt             DateTime?
  // Cuánto de este turno se cobró en efectivo / banco. Necesario para revertir el cobro
  // con el MEDIO correcto si el turno se elimina ya estando (parcial o totalmente) cobrado.
  paidCash           Int       @default(0)
  paidBank           Int       @default(0)
  paidBy             String? // quién registró el cobro al cliente
  paidByName         String?
  createdBy          String?
  createdByName      String?
  createdAt          DateTime  @default(now())

  hourlyClient HourlyClient @relation(fields: [hourlyClientId], references: [id], onDelete: Cascade)

  @@index([hourlyClientId])
  @@index([hourlyClientId, driverPaid])
  @@index([hourlyClientId, paid])
}

// ============================================================
// Dispositivos (PCs) y bitácora de actividad
// ============================================================

enum DeviceStatus {
  pending // recién visto, aún sin autorizar: NO puede operar ni ver datos
  approved // autorizado por un admin (y con nombre): opera normal
  blocked // rechazado/bloqueado por un admin: no puede operar
}

// Un PC (navegador) que se conecta al sistema. El `id` es un UUID que genera el propio
// navegador y guarda en localStorage, y que manda en cada request (header X-Device-Id).
// La identidad es "por navegador": si borran los datos del navegador, aparece un Device
// nuevo en `pending` (a propósito — el admin lo reautoriza y renombra). El PC servidor
// (loopback) se auto-aprueba para que el admin nunca quede bloqueado (ver device.service).
model Device {
  id                String       @id // UUID del navegador (X-Device-Id); NO @default: lo fija el cliente
  name              String? // nombre que le pone el admin ("PC 1"); null = sin nombre (solo mientras pending)
  status            DeviceStatus @default(pending)
  trusted           Boolean      @default(false) // auto-aprobado por ser el PC servidor (loopback)
  firstUserId       String? // primer usuario que lo usó (trazabilidad)
  firstUserName     String?
  lastUserName      String? // último usuario visto en este PC
  firstSeenIp       String?
  lastSeenIp        String?
  userAgent         String?      @db.Text
  approvedBy        String?
  approvedByName    String?
  approvedAt        DateTime?
  // Señal de UNA sola vez para "Cerrar sistema": el PC, en su próximo sondeo, ve este
  // valor más nuevo que su último logout y se va al login. No bloquea (sigue approved).
  logoutRequestedAt DateTime?
  lastSeenAt        DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([lastSeenAt])
}

// Bitácora: una fila por cada acción que CAMBIA datos (POST/PATCH/DELETE), con el PC y el
// usuario que la hizo. Es la fuente de "ver desde qué PC se hace cada movimiento" a nivel
// global (la etiqueta inline en Movimientos usa los campos deviceName de cada registro).
model ActivityLog {
  id         String   @id @default(cuid())
  deviceId   String? // id del Device (no FK: la bitácora sobrevive aunque se borre el Device)
  deviceName String? // nombre del PC en el momento de la acción (snapshot)
  userId     String?
  userName   String?
  method     String // POST | PATCH | DELETE
  path       String // ruta del endpoint, p. ej. /bank-transactions
  action     String? // resumen legible opcional
  statusCode Int?
  createdAt  DateTime @default(now())

  @@index([deviceId])
  @@index([createdAt])
}

// Un abono es un evento fechado; los acumulados de ClientDebt son solo un resumen.
model ClientDebtPayment {
  id              String     @id @default(cuid())
  debtId          String
  clientId        String
  description     String
  paidAmount      Int
  paidCash        Int        @default(0)
  paidBank        Int        @default(0)
  paidAt          DateTime   @default(now())
  paidBy          String?
  paidByName      String?
  paidDeviceId    String?
  paidDeviceName  String?
  legacyAggregate Boolean    @default(false)
  debt            ClientDebt @relation(fields: [debtId], references: [id], onDelete: Restrict)
  client          Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([debtId])
  @@index([clientId])
  @@index([paidAt])
}

/// Auditoría de la migración F14 (14-oct-2026): separación de la base (libro BaseTransaction)
/// y la cuenta de comisiones (Driver.pendingDebt/creditAmount). Un registro por domiciliario
/// con base en el libro: saldos antes/después y residuo regularizado (sin movimiento de caja).
model F14DriverMigration {
  driverId           String   @id
  pendingDebtBefore  Int
  creditAmountBefore Int
  baseLedger         Int
  baseShown          Int
  residueRegularized Int
  pendingDebtAfter   Int
  creditAmountAfter  Int
  migratedAt         DateTime @default(now())
}
